<!DOCTYPE html>
<html>
<head>
<title>Gaming Arena</title>

<link href="https://fonts.googleapis.com/css2?family=Poppins&display=swap" rel="stylesheet">

<style>
body{
margin:0;
font-family:Poppins;
background:linear-gradient(135deg,#000000,#434343);
color:white;
text-align:center;
}

h1{
margin-top:30px;
}

/* GAME CARDS */
.container{
display:flex;
flex-wrap:wrap;
justify-content:center;
gap:20px;
padding:40px;
}

.card{
background:rgba(0,0,0,0.6);
padding:20px;
border-radius:15px;
width:220px;
transition:0.3s;
cursor:pointer;
}

.card:hover{
transform:scale(1.05);
background:rgba(0,0,0,0.85);
}

/* DETAILS BOX */
.details{
display:none;
background:rgba(0,0,0,0.75);
margin:20px auto;
padding:25px;
width:80%;
max-width:650px;
border-radius:15px;
text-align:left;
}

.details h2{
color:#ffd369;
}

.contact{
margin-top:15px;
background:rgba(255,255,255,0.1);
padding:10px;
border-radius:8px;
}

/* BUTTON */
button{
margin-top:15px;
padding:10px 20px;
border:none;
background:#ffd369;
color:black;
border-radius:8px;
cursor:pointer;
font-weight:bold;
}

button:hover{
background:white;
}
</style>
</head>

<body>

<h1>🎮 Gaming Arena</h1>
<p>Select Game Category</p>

<div class="container">

<div class="card" onclick="showDetails('indoor')">♟ Indoor Games</div>
<div class="card" onclick="showDetails('outdoor')">⚽ Outdoor Games</div>
<div class="card" onclick="showDetails('esports')">🎮 E-Sports (PUBG, Free Fire)</div>

</div>

<div id="details" class="details"></div>
<script>

function showDetails(type){

let box = document.getElementById("details");

let data = {

indoor: {
title:"♟ Indoor Games",
time:"May 18 | 4:00 PM - 5:30 PM",
games:[
  "Carrom",
  "Table Tennis",
  "Chess"
],
rules:"• Individual matches\n• Knockout rounds\n• Fair play mandatory",
contact:"Amit (Senior) - 9876541111"
},

outdoor: {
title:"⚽ Outdoor Games",
time:"May 18 | 5:30 PM - 7:00 PM",
games:["Football","Basketball","Badminton"],
rules:"• Team-based matches\n• Follow sports rules\n• Proper dress required",
contact:"Rohit (Senior) - 9876502222"
},

esports: {
title:"🎮 E-Sports Tournament",
time:"May 18 | 7:00 PM - 9:00 PM",
games:["PUBG Mobile","Free Fire","BGMI"],
rules:"• Squad or Solo mode\n• No hacks/cheats\n• Internet provided",
contact:"Karan (Senior) - 9876503333"
}

};

let d = data[type];

/* CREATE GAME OPTIONS */
let gameOptions = d.games.map(game => 
`<button onclick="selectGame('${type}','${game}')">${game}</button>`
).join("<br><br>");

box.innerHTML = `
<h2>${d.title}</h2>

<p><b>🕒 Time:</b> ${d.time}</p>

<p><b>🎯 Select Game:</b></p>
${gameOptions}

<p><b>📜 Rules:</b><br>${d.rules.replace(/\n/g,"<br>")}</p>

<div class="contact">
<b>📞 Contact for Playing:</b><br>
${d.contact}
</div>
`;

box.style.display = "block";
}

/* GAME SELECTED */
function selectGame(type, game){
alert("You selected: " + game);

window.location.href = "/register?event=gaming&category=" + type + "&game=" + game;
}

</script>

</body>
</html>