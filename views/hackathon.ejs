<!DOCTYPE html>
<html>
<head>
<title>Hackathon</title>

<link href="https://fonts.googleapis.com/css2?family=Poppins&display=swap" rel="stylesheet">

<style>
body{
margin:0;
font-family:Poppins;
background:linear-gradient(135deg,#141e30,#243b55);
color:white;
}

/* HEADER */
.header{
text-align:center;
padding:40px 20px;
}

.header h1{
font-size:40px;
color:#ffd369;
}

.header p{
color:#ccc;
}

/* SECTION */
.section{
background:rgba(0,0,0,0.6);
margin:20px auto;
padding:25px;
width:85%;
max-width:900px;
border-radius:15px;
box-shadow:0 0 20px rgba(0,0,0,0.5);
}

/* TITLES */
.section h2{
color:#ffd369;
margin-bottom:10px;
}

/* LIST */
ul{
text-align:left;
line-height:1.8;
}

/* BUTTON */
.btn{
display:inline-block;
margin-top:15px;
padding:12px 20px;
background:#25D366;
color:white;
text-decoration:none;
border-radius:8px;
font-weight:bold;
transition:0.3s;
}

.btn:hover{
background:#1ebe5d;
transform:scale(1.05);
}

/* BADGE */
.badge{
background:#ffd369;
color:black;
padding:5px 10px;
border-radius:6px;
font-size:14px;
}

</style>
</head>

<body>

<div class="header">
<h1>🚀 24-Hour Hackathon</h1>
<p>Build • Innovate • Compete</p>
<span class="badge">May 17 | 6:00 PM - May 18 | 6:00 PM</span>
</div>

<!-- ABOUT -->
<div class="section">
<h2>📌 About Hackathon</h2>
<p>
Join our exciting <b>24-hour Hackathon</b> where creativity meets technology.
Work in teams, solve real-world problems, and build innovative solutions.
</p>
</div>

<!-- TOPICS -->
<div class="section">
<h2>💡 Hackathon Topics</h2>
<ul>
<li>AI & Machine Learning</li>
<li>Web & App Development</li>
<li>Smart City Solutions</li>
<li>Healthcare Innovation</li>
<li>FinTech & Blockchain</li>
<li>Open Innovation (Any Idea)</li>
</ul>
</div>

<!-- RULES -->
<div class="section">
<h2>📜 Rules & Guidelines</h2>
<ul>
<li>Team size: 2 - 4 members</li>
<li>All work must be done during the hackathon</li>
<li>Use of open-source tools allowed</li>
<li>No plagiarism (strict disqualification)</li>
<li>Final project must be presented to judges</li>
<li>Internet allowed but no pre-built projects</li>
</ul>
</div>

<!-- PRIZES -->
<div class="section">
<h2>🏆 Prizes & Rewards</h2>
<ul>
<li>🥇 1st Prize: ₹10,000 + Trophy + Certificate</li>
<li>🥈 2nd Prize: ₹5,000 + Certificate</li>
<li>🥉 3rd Prize: ₹2,000 + Certificate</li>
<li>🎖 Participation Certificate for all</li>
</ul>
</div>

<!-- WHATSAPP -->
<div class="section" style="text-align:center;">
<h2>📲 Join WhatsApp Group</h2>
<p>All updates, topics, and announcements will be shared here</p>

<a href="https://wa.me/919999999999" target="_blank" class="btn">
Join WhatsApp Group
</a>

</div>

<!-- REGISTER -->
<div class="section" style="text-align:center;">
<h2>📝 Register Now</h2>

<a href="/register?event=hackathon" class="btn" style="background:#ffd369; color:black;">
Register for Hackathon
</a>

</div>

</body>
</html>


