<!DOCTYPE html>
<html>
<head>
<title>Dance Competition</title>

<link href="https://fonts.googleapis.com/css2?family=Poppins&display=swap" rel="stylesheet">

<style>
body{
margin:0;
font-family:Poppins;
background:linear-gradient(135deg,#ff416c,#ff4b2b);
color:white;
text-align:center;
}

h1{
margin-top:30px;
}

/* CATEGORY CARDS */
.container{
display:flex;
flex-wrap:wrap;
justify-content:center;
gap:20px;
padding:40px;
}

.card{
background:rgba(0,0,0,0.6);
padding:20px;
border-radius:15px;
width:220px;
transition:0.3s;
cursor:pointer;
}

.card:hover{
transform:scale(1.05);
background:rgba(0,0,0,0.8);
}

/* DETAILS BOX */
.details{
display:none;
background:rgba(0,0,0,0.7);
margin:20px auto;
padding:25px;
width:80%;
max-width:600px;
border-radius:15px;
text-align:left;
}

.details h2{
color:#ffd369;
}

button{
margin-top:15px;
padding:10px 20px;
border:none;
background:#ffd369;
color:black;
border-radius:8px;
cursor:pointer;
font-weight:bold;
}

button:hover{
background:white;
}
</style>
</head>

<body>

<h1>💃 Dance Competition</h1>
<p>Select Category</p>

<div class="container">

<div class="card" onclick="showDetails('classical')">🩰 Classical Dance</div>
<div class="card" onclick="showDetails('hiphop')">🔥 Hip-Hop</div>
<div class="card" onclick="showDetails('freestyle')">✨ Freestyle</div>
<div class="card" onclick="showDetails('group')">👯 Group Dance</div>

</div>

<!-- DETAILS -->
<div id="details" class="details"></div>

<script>

function showDetails(type){

let box = document.getElementById("details");

let data = {

classical: {
title:"🩰 Classical Dance",
time:"May 17 | 2:00 PM - 3:00 PM",
rules:"• Traditional styles only\n• Max 5 minutes\n• Solo performance",
desc:"Perform classical dance forms like Bharatanatyam, Kathak etc."
},

hiphop: {
title:"🔥 Hip-Hop",
time:"May 17 | 3:00 PM - 4:00 PM",
rules:"• Energetic performance\n• Max 4 minutes",
desc:"Show your street dance skills with powerful moves."
},

freestyle: {
title:"✨ Freestyle",
time:"May 17 | 4:00 PM - 5:00 PM",
rules:"• Any dance style allowed\n• Max 4 minutes",
desc:"Express your creativity with your own dance style."
},

group: {
title:"👯 Group Dance",
time:"May 17 | 5:00 PM - 6:00 PM",
rules:"• Team of 3-8 members\n• Max 6 minutes",
desc:"Perform coordinated group dance with synchronization."
}

};

let d = data[type];

box.innerHTML = `
<h2>${d.title}</h2>

<p><b>🕒 Time:</b> ${d.time}</p>

<p><b>📜 Rules:</b><br>${d.rules.replace(/\n/g,"<br>")}</p>

<p><b>ℹ️ Description:</b> ${d.desc}</p>

<button onclick="register('${type}')">Register</button>
`;

box.style.display = "block";
}

/* REGISTER */
function register(type){
window.location.href="/register?event=dance&category=" + type;
}

</script>

</body>
</html>