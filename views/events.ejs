<!DOCTYPE html>
<html>
<head>
<title><%= title %></title>

<link href="https://fonts.googleapis.com/css2?family=Orbitron:wght@500&family=Poppins:wght@300;400;600&display=swap" rel="stylesheet">
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">

<style>
body{
margin:0;
font-family:'Poppins', sans-serif;
background:linear-gradient(135deg,#0f0f0f,#1c1c1c,#2b2b2b);
color:white;
}

.events{
padding:80px 20px;
text-align:center;
}

.events h1{
font-family:'Orbitron', sans-serif;
color:#FFFDD0;
font-size:40px;
margin-bottom:10px;
}

.events p{
color:#ccc;
margin-bottom:50px;
}

.event-container{
display:flex;
flex-wrap:wrap;
justify-content:center;
gap:30px;
}

.event-card{
background:#1a1a1a;
width:280px;
border-radius:12px;
padding:20px;
box-shadow:0 8px 30px rgba(0,0,0,0.6);
transition:0.3s;

opacity:0;
transform:translateY(30px);
animation:fadeUp 0.8s ease forwards;
}

@keyframes fadeUp{
to{
opacity:1;
transform:translateY(0);
}
}

.event-card:hover{
transform:translateY(-8px) scale(1.03);
box-shadow:0 0 20px #ffd369, 0 0 40px rgba(255,211,105,0.4);
}

.event-card i{
font-size:30px;
margin-bottom:10px;
color:#ffd369;
}

.event-card h3{
color:#ffd369;
margin-bottom:10px;
}

.event-card p{
color:#ccc;
font-size:14px;
}

.event-info{
margin-top:10px;
font-size:13px;
color:#aaa;
}

.event-info i{
margin-right:5px;
color:#ffd369;
}

/* Make whole card clickable */
.event-card a{
text-decoration:none;
color:inherit;
display:block;
}
</style>
</head>

<body>

<section class="events">

<h1>Our Events</h1>
<p><%= subtitle %></p>

<div class="event-container">

<!-- 17 MAY -->

<!-- ✅ CODING (FIXED + CLICKABLE) -->
