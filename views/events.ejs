<a href="/event/coding">

<i class="fas fa-code"></i>
<h3>Coding Competition</h3>
<p>Test your programming skills and compete with the best coders.</p>

<div class="event-info">
<p><i class="fas fa-calendar"></i> May 17</p>
<p><i class="fas fa-clock"></i> 10:00 AM - 12:00 PM</p>
</div>

</a>
</div>

<div class="event-card">
<a href="/event/dance">

<i class="fas fa-music"></i>
