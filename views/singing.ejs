<!DOCTYPE html>
<html>
<head>
<title>Singing Competition</title>

<link href="https://fonts.googleapis.com/css2?family=Poppins&display=swap" rel="stylesheet">

<style>
body{
margin:0;
font-family:Poppins;
background:linear-gradient(135deg,#1a2a6c,#b21f1f,#fdbb2d);
color:white;
text-align:center;
}

h1{
margin-top:30px;
}

.container{
display:flex;
flex-wrap:wrap;
justify-content:center;
gap:20px;
padding:40px;
}

.card{
background:rgba(0,0,0,0.6);
padding:20px;
border-radius:15px;
width:220px;
transition:0.3s;
cursor:pointer;
}

.card:hover{
transform:scale(1.05);
background:rgba(0,0,0,0.8);
}

</style>
</head>

<body>

<h1>🎤 Singing Competition</h1>
<p>Select Category</p>

<div class="container">

<div class="card">🎼 Classical Singing</div>
<div class="card">🎶 Semi-Classical</div>
<div class="card">🎧 Rap / Hip-Hop</div>
<div class="card">🎤 Bollywood</div>

</div>

</body>
</html>